# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and # Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="your_DATABASE_URL"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="your_DIRECT_URL"

YOUTUBE_API_KEY="your_YOUTUBE_API_KEY"

NEXT_PUBLIC_SUPABASE_URL=your_supabase_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=your_NEXT_PUBLIC_SITE_URL